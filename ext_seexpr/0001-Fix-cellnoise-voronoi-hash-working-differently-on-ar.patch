From 965611461e93c796909a267b5fd8005e60f7155a Mon Sep 17 00:00:00 2001
From: Dmitry Kazakov <dimula73@gmail.com>
Date: Thu, 26 Nov 2026 10:07:21 +0100
Subject: [PATCH] Fix cellnoise/voronoi/hash working differently on arm64 and
 x86_64

`cellnoise()`, `ccellnoise()`, `voronoi()`, `cvoronoi()`, `pvoronoi()`, `hash()` and
`pick()` now give the same results on arm64 (Apple Silicon, Linux aarch64, Windows on ARM64) as on x86_64.

On arm64 they differed wherever a cell coordinate, or an argument of `hash()` or
`pick()`, was negative, because SeExpr converted a negative number to an unsigned
integer, which is undefined in C++.

Backported from Natron's fix:
https://github.com/NatronGitHub/Natron/pull/1676
---
 src/KSeExpr/ExprBuiltins.cpp | 4 +++-
 src/KSeExpr/Noise.cpp        | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/KSeExpr/ExprBuiltins.cpp b/src/KSeExpr/ExprBuiltins.cpp
index 5b5f71e..435a8ff 100644
--- a/src/KSeExpr/ExprBuiltins.cpp
+++ b/src/KSeExpr/ExprBuiltins.cpp
@@ -509,7 +509,9 @@ double hash(int n, double* args)
         // make irrational to generate fraction and combine xor into 32 bits
         int exp = 0;
         double frac = frexp(args[i] * double(M_E * M_PI), &exp);
-        uint32_t s = (uint32_t)(frac * UINT32_MAX) ^ (uint32_t)exp;
+        // convert through int64_t: frac is negative for negative args, and converting
+        // a negative double to uint32_t is undefined (x86_64 wraps it, arm64 clamps it)
+        uint32_t s = (uint32_t)(int64_t)(frac * UINT32_MAX) ^ (uint32_t)exp;
 
         // blend with seed (constants from Numerical Recipes, attrib. from Knuth)
         static const uint32_t M = 1664525;
diff --git a/src/KSeExpr/Noise.cpp b/src/KSeExpr/Noise.cpp
index 7b7bc44..a9de196 100644
--- a/src/KSeExpr/Noise.cpp
+++ b/src/KSeExpr/Noise.cpp
@@ -132,7 +132,9 @@ template<int d_in, int d_out, class T> void CellNoise(const T *in, T *out)
     uint32_t index[d_in];
     int dim = 0;
     for (int k = 0; k < d_in; k++)
-        index[k] = uint32_t(KSeExpr::Utils::floor(in[k]));
+        // convert through int64_t: converting a negative double to uint32_t is undefined
+        // (x86_64 wraps it, arm64 clamps it to 0, so cellnoise and voronoi differ)
+        index[k] = uint32_t(int64_t(KSeExpr::Utils::floor(in[k])));
     while (1) {
         out[dim] = hashReduce<d_in>(index) * (1.0 / 0xffffffffu);
         if (++dim >= d_out)
-- 
